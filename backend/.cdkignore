serverless.yml

# Documentation
README.md
*.md

# Build artifacts
dist/
build/
.nyc_output/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/